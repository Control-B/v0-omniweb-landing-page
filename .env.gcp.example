# ── GCP VM Production Environment Configuration ──────────────────────────────
ENVIRONMENT=production

# Database & Cache
POSTGRES_DB=omniweb_engine
POSTGRES_USER=omniweb
POSTGRES_PASSWORD=omniweb_secure_pwd_2026

# Auth & Security
SECRET_KEY=generate_a_secure_random_hex_key_here_for_production
JWT_SECRET_KEY=generate_a_secure_random_hex_key_here_for_production

# AI Intelligence Models
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Voice & LiveKit Telephony Plane
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

DEEPGRAM_API_KEY=your_deepgram_api_key
CARTESIA_API_KEY=your_cartesia_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Features
ENABLE_LANGGRAPH=true
ENABLE_LIVEKIT=true
ENABLE_POLICY_ENGINE=true
ENABLE_DEEPAGENTS=true
ENABLE_SUPERVISOR_WAR_ROOM=true
