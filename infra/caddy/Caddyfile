:80 {
    # Encode responses with gzip & zstandard compression
    encode gzip zstd

    # Enforce request body limits to mitigate volumetric attacks
    request_body {
        max_size 10MB
    }

    # Enterprise-grade HTTP Security Headers
    header {
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Legacy XSS protection for older user agents
        X-XSS-Protection "1; mode=block"
        # Strict referrer leakage prevention
        Referrer-Policy "strict-origin-when-cross-origin"
        # Control browser features & permissions (allow microphone for AI voice calling)
        Permissions-Policy "camera=(), microphone=(self), geolocation=()"
        # Cross-Origin Opener Policy for secure popups/OAuth
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        # Remove reverse proxy signature
        -Server
    }

    # Forward API routes to FastAPI Backend
    handle /api/engine/* {
        uri strip_prefix /api/engine
        reverse_proxy backend:8000
    }

    handle /health {
        reverse_proxy backend:8000
    }

    # Forward all other requests to Next.js Frontend
    handle {
        reverse_proxy frontend:3000
    }
}
